# Copie para .env.production e informe o endereço acessível pelo servidor Next.js.
# Exemplo: https://api.seu-dominio.com
# Também pode ser definido diretamente nas variáveis da hospedagem.
FUTCOMPETITIVO_API_URL=
# Mesmos valores de CLIENT_ID e CLIENT_SECRET configurados no backend.
# Cadastre como variáveis privadas na Vercel, sem o prefixo NEXT_PUBLIC_.
FUTCOMPETITIVO_CLIENT_ID=
FUTCOMPETITIVO_CLIENT_SECRET=
